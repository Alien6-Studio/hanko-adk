{
  "name": "@alien6/hanko-adk",
  "version": "0.3.0",
  "description": "Reusable Hanko IAM runtime adapters for product applications",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alien6-Studio/hanko-adk.git",
    "directory": "typescript"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authjs": {
      "types": "./dist/authjs.d.ts",
      "import": "./dist/authjs.js"
    },
    "./passport": {
      "types": "./dist/passport.d.ts",
      "import": "./dist/passport.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:coverage": "c8 --check-coverage --lines 85 --statements 85 --functions 95 --branches 70 --reporter=lcov --reporter=text node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "jwks-rsa": "^3.2.0"
  },
  "peerDependencies": {
    "next-auth": ">=5.0.0-beta.25 <6",
    "passport-jwt": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "next-auth": {
      "optional": true
    },
    "passport-jwt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "c8": "^12.0.0",
    "next-auth": "^5.0.0-beta.32",
    "passport-jwt": "^4.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Alien6-Studio/hanko-adk",
  "bugs": {
    "url": "https://github.com/Alien6-Studio/hanko-adk/issues"
  }
}
