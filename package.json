{
  "name": "@alien6-studio/hankoshell-typescript-adk",
  "version": "0.6.0",
  "description": "HankoShell OIDC and IAM clients with Auth.js, Passport and headless React account screens",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alien6-Studio/hankoshell-typescript-adk.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authjs": {
      "types": "./dist/authjs.d.ts",
      "import": "./dist/authjs.js"
    },
    "./passport": {
      "types": "./dist/passport.d.ts",
      "import": "./dist/passport.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./identity/server": {
      "types": "./dist/identity-server.d.ts",
      "import": "./dist/identity-server.js"
    },
    "./identity/react": {
      "types": "./dist/identity-react.d.ts",
      "import": "./dist/identity-react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:coverage": "c8 --check-coverage --lines 85 --statements 85 --functions 95 --branches 70 --reporter=lcov --reporter=text node --import tsx --test 'src/**/*.test.ts'",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run lint && npm run test:coverage && npm run build && npm run test:package && npm pack --dry-run"
  },
  "dependencies": {
    "jose": "^6.2.1",
    "jwks-rsa": "^4.1.0"
  },
  "peerDependencies": {
    "@alien6-studio/hankoshell-keycloak-theme-builder": ">=0.1.0 <1",
    "next-auth": ">=5.0.0-beta.25 <6",
    "passport-jwt": "^4.0.1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next-auth": {
      "optional": true
    },
    "passport-jwt": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@alien6-studio/hankoshell-keycloak-theme-builder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alien6-studio/hankoshell-keycloak-theme-builder": "0.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "c8": "^12.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "next-auth": "^5.0.0-beta.32",
    "passport-jwt": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Alien6-Studio/hankoshell-typescript-adk",
  "bugs": {
    "url": "https://github.com/Alien6-Studio/hankoshell-typescript-adk/issues"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "keywords": [
    "hankoshell",
    "authentication",
    "oidc",
    "iam",
    "authjs",
    "passport",
    "react"
  ]
}
